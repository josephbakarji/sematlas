# Copy to .env and fill in what you have. Everything is optional except one
# way to reach a model; without any key the topic graphs on / still work.

# ---- Models
# One OpenRouter key covers everything: Jev (the ranking model) and the model
# that writes the answers. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Alternatives, used only when OPENROUTER_API_KEY is not set:
TYPESAFE_API_KEY=        # Jev directly, from TypeSafe
OPENAI_API_KEY=          # ChatGPT models directly (OPENAI_BASE_URL works too,
                         # e.g. a local server such as Ollama)
ANTHROPIC_API_KEY=       # Claude directly, with native citations

# SEMATLAS_LLM=openrouter                     # force: openrouter | openai | anthropic
# SEMATLAS_ANSWER_MODEL=openai/gpt-5.4-mini   # the writing model
# JEV_MODEL=typesafe/jev-1.13                 # the ranking model

# ---- Who pays (for a public deployment)
# Visitors get a few free questions a day, paid by your key, inside a daily
# dollar budget counted from the costs the providers report. Beyond that they
# connect their own OpenRouter account. Counts are in memory per process.
# SEMATLAS_FREE_PER_DAY=5          # free questions per visitor per day
# SEMATLAS_FREE_BUDGET_USD=2       # free spending per day, all visitors
# SEMATLAS_OWN_KEY_PER_HOUR=120    # abuse limit for visitors using their own key

# ---- Identity
# Wikimedia asks API clients for a way to contact the operator. Set this to
# your own site, issue tracker or email if you run a copy.
# SEMATLAS_CONTACT=https://github.com/josephbakarji/sematlas/issues
# SEMATLAS_REPO_URL=https://github.com/josephbakarji/sematlas
